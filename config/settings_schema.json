        "id": "primary_font",
        "label": "Primary font",
        "default": "dm_sans_n4"
      },
      {
        "type": "font_picker",
        "id": "secondary_font",
        "label": "Secondary font",
        "default": "bricolage_grotesque_n4"
      },
      {
        "type": "select",
        "id": "primary_font_color_source",
        "label": "Primary font color",
        "options": [
          {
            "value": "ink",
            "label": "Ink"
          },
          {
            "value": "night",
            "label": "Night"
          },
          {
            "value": "white",
            "label": "White"
          },
          {
            "value": "cream",
            "label": "Cream"
          },
          {
            "value": "lavender",
            "label": "Lavender"
          },
          {
            "value": "purple",
            "label": "Purple"
          },
          {
            "value": "royal_purple",
            "label": "Royal Purple"
          },
          {
            "value": "mint",
            "label": "Mint"
          },
          {
            "value": "lemon",
            "label": "Lemon"
          }
        ],
        "default": "night"
      },
      {
        "type": "checkbox",
        "id": "primary_font_color_use_custom",
        "label": "Override primary font color",
        "default": false
      },
      {
        "type": "color",
        "id": "primary_font_color_custom",
        "label": "Custom primary font color",
        "default": "#292237"
      },
      {
        "type": "select",
        "id": "secondary_font_color_source",
        "label": "Secondary font color",
        "options": [
          {
            "value": "ink",
            "label": "Ink"
          },
          {
            "value": "night",
            "label": "Night"
          },
          {
            "value": "white",
            "label": "White"
          },
          {
            "value": "cream",
            "label": "Cream"
          },
          {
            "value": "lavender",
            "label": "Lavender"
          },
          {
            "value": "purple",
            "label": "Purple"
          },
          {
            "value": "royal_purple",
            "label": "Royal Purple"
          },
          {
            "value": "mint",
            "label": "Mint"
          },
          {
            "value": "lemon",
            "label": "Lemon"
          }
        ],
        "default": "ink"
      },
      {
        "type": "checkbox",
        "id": "secondary_font_color_use_custom",
        "label": "Override secondary font color",
        "default": false
      },
      {
        "type": "color",
        "id": "secondary_font_color_custom",
        "label": "Custom secondary font color",
        "default": "#181521"
      }
    ]
  },
  {
    "name": "Newsletter Popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "newsletter_popup",
        "label": "Enable newsletter popup",
        "default": true
      },
      {
        "type": "range",
        "id": "newsletter_duration",
        "label": "Time to display",
        "info": "Time is seconds before the popup is displayed.",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 0
      },
      {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Heading",
        "default": "Join the family!"
      },
      {
        "type": "inline_richtext",
        "id": "newsletter_text",
        "label": "Text",
        "default": "Sign up for access to behind the scenes updates, exclusive news, and invites to our community events."
      },
      {
        "type": "text",
        "id": "newsletter_btn_label",
        "label": "Submit button label",
        "default": "Sign up"
      },
      {
        "type": "checkbox",
        "id": "newsletter_use_default_color_scheme",
        "label": "Use default color scheme",
        "default": true
      },
      {
        "type": "color_scheme",
        "id": "newsletter_color_scheme",
        "label": "Color scheme",
        "default": "scheme_1"
      },
      {
        "type": "select",
        "id": "newsletter_content_alignment",
        "label": "Content alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          },
          {
            "value": "justify",
            "label": "Justify"
          }
        ],
        "default": "center"
      }
    ]
  },
