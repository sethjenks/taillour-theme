      {
        "type": "color",
        "id": "secondary_font_color_custom",
        "label": "Custom secondary font color",
        "default": "#181521"
      }
    ]
  },
  {
    "name": "Newsletter Popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "newsletter_popup",
        "label": "Enable newsletter popup",
        "default": true
      },
      {
        "type": "range",
        "id": "newsletter_duration",
        "label": "Time to display",
        "info": "Time is seconds before the popup is displayed.",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 0
      },
      {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Heading",
        "default": "Join the family!"
      },
      {
        "type": "inline_richtext",
        "id": "newsletter_text",
        "label": "Text",
        "default": "Sign up for access to behind the scenes updates, exclusive news, and invites to our community events."
      },
      {
        "type": "text",
        "id": "newsletter_btn_label",
        "label": "Submit button label",
        "default": "Sign up"
      }
    ]
  },
