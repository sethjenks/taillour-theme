      },
      {
        "type": "font_picker",
        "id": "secondary_font",
        "label": "Secondary font",
        "default": "bricolage_grotesque_n4"
      },
      {
        "type": "select",
        "id": "primary_font_color_source",
        "label": "Primary font color",
        "options": [
