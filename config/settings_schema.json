        "id": "color_cream",
        "label": "Cream",
        "default": "#F5F1F1"
      },
      {
        "type": "color",
        "id": "color_lavender",
        "label": "Lavender",
        "default": "#E2D6FC"
      },
      {
        "type": "color",
        "id": "color_purple",
        "label": "Purple",
        "default": "#685196"
      },
      {
        "type": "color",
        "id": "color_smoke_purple",
        "label": "Smoke Purple",
