            "label": "Lavender"
          },
          {
            "value": "purple",
            "label": "Purple"
          },
          {
            "value": "royal_purple",
            "label": "Royal Purple"
          },
          {
            "value": "mint",
            "label": "Mint"
          },
          {
            "value": "lemon",
            "label": "Lemon"
          }
        ],
        "default": "ink"
      },
      {
        "type": "checkbox",
        "id": "secondary_font_color_use_custom",
        "label": "Override secondary font color",
