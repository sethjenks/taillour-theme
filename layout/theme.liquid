<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- unless settings.favicon == blank -%}
    <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 512, height: 512 }}">
  {%- endunless -%}

  <title>{{ page_title }}
    {% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
    {% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
    {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {%- if request.path contains "/pages/thank-you" -%}
  <meta name="robots" content="noindex">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- liquid
    assign primary_color = settings.color_night
    case settings.primary_font_color_source
      when 'ink'
        assign primary_color = settings.color_ink
      when 'night'
        assign primary_color = settings.color_night
      when 'white'
        assign primary_color = settings.color_white
      when 'cream'
        assign primary_color = settings.color_cream
      when 'lavender'
        assign primary_color = settings.color_lavender
      when 'purple'
        assign primary_color = settings.color_purple
      when 'royal_purple'
        assign primary_color = settings.color_royal_purple
      when 'mint'
        assign primary_color = settings.color_mint
      when 'lemon'
        assign primary_color = settings.color_lemon
    endcase

    assign secondary_color = settings.color_ink
    case settings.secondary_font_color_source
      when 'ink'
        assign secondary_color = settings.color_ink
      when 'night'
        assign secondary_color = settings.color_night
      when 'white'
        assign secondary_color = settings.color_white
      when 'cream'
        assign secondary_color = settings.color_cream
      when 'lavender'
        assign secondary_color = settings.color_lavender
      when 'purple'
        assign secondary_color = settings.color_purple
      when 'royal_purple'
        assign secondary_color = settings.color_royal_purple
      when 'mint'
        assign secondary_color = settings.color_mint
      when 'lemon'
        assign secondary_color = settings.color_lemon
    endcase

    if settings.primary_font_color_use_custom and settings.primary_font_color_custom != blank
      assign primary_color = settings.primary_font_color_custom
    endif

    if settings.secondary_font_color_use_custom and settings.secondary_font_color_custom != blank
      assign secondary_color = settings.secondary_font_color_custom
    endif
  -%}

  <style>
    {{ settings.primary_font | font_face: font_display: 'swap' }}
    {{ settings.primary_font | font_modify: 'weight', '700' | font_face: font_display: 'swap' }}
    {{ settings.secondary_font | font_face: font_display: 'swap' }}
    {{ settings.secondary_font | font_modify: 'weight', '700' | font_face: font_display: 'swap' }}
  </style>

  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'mobile.css' | asset_url }}" media="(max-width: 768px)">
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
  <style>
    :root {
      --ink: {{ settings.color_ink }};
      --night: {{ settings.color_night }};
      --white: {{ settings.color_white }};
      --cream: {{ settings.color_cream }};
      --lavender: {{ settings.color_lavender }};
      --purple: {{ settings.color_purple }};
      --smoke-purple: {{ settings.color_smoke_purple }};
      --royal-purple: {{ settings.color_royal_purple }};
      --mint: {{ settings.color_mint }};
      --lemon: {{ settings.color_lemon }};
      --font-primary: {{ settings.primary_font.family }}, {{ settings.primary_font.fallback_families }};
      --font-secondary: {{ settings.secondary_font.family }}, {{ settings.secondary_font.fallback_families }};
      --font-primary-color: {{ primary_color }};
      --font-secondary-color: {{ secondary_color }};
      --form-max-width: {{ settings.form_max_width | append: 'px' }};
      --dialog-max-width: {{ settings.dialog_max_width | append: 'px' }};
    }

    {%- for scheme in settings.color_schemes -%}
    .color-{{ scheme.id }} {
      --theme-bg-primary: {{ scheme.settings.bg_primary }};
      --theme-bg-secondary: {{ scheme.settings.bg_secondary }};
      --theme-text-primary: {{ scheme.settings.text_primary }};
      --theme-text-secondary: {{ scheme.settings.text_secondary }};
    }
    {%- endfor -%}
  </style>

  {% render 'schemas' %}
  {% render 'social-meta-tags' %}
  {{ content_for_header }}
</head>

{%- assign default_scheme = settings.default_color_scheme -%}
<body class="{% if default_scheme != blank %}color-{{ default_scheme.id }} {% endif %}page-{{ request.page_type | handle }}">
  {% comment %}
  Skip to content accessibility link
  {% endcomment %}
  <a href="#main-content" class="skip-to-content desktop">
    <span>Skip to content</span>
  </a>

  {% section 'announcement-bar' %}
  {% section 'nav' %}

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  <footer class="site-footer">
    {% sections 'footer-group' %}
  </footer>

  {% liquid
  # Newsletter Popup.
  if settings.newsletter_popup
    render 'newsletter-popup'
  endif
  %}
</body>
</html>
