{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- assign background_image = section.settings.background_image -%}
{%- if background_image != blank -%}
  <style>
    #{{ section.id }}.announcement-bar {
      background-image: url('{{ background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  </style>
{%- endif -%}
<div id="{{ section.id }}" class="announcement-bar fill center gradient-accent {{ scheme_class }}" style="background: var(--theme-bg-primary, var(--accent-gradient)); color: var(--theme-text-primary, var(--ink)); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));">
  {{ section.settings.text }}
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section gradient-accent",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Welcome to our store! <a href=\"#\"> Find out more</a>"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
