{%- assign padding_default = section.settings.padding_top_bottom | default: 6 -%}
{%- assign padding_top = padding_default -%}
{%- assign padding_bottom = padding_default -%}
{%- if section.settings.enable_padding_overrides -%}
  {%- assign padding_top = section.settings.padding_top -%}
  {%- assign padding_bottom = section.settings.padding_bottom -%}
{%- endif -%}
<div id="{{ section.id }}" class="section-wrap" style="--section-padding-default: {{ padding_default | append: 'rem' }};{% if section.settings.enable_padding_overrides %} --section-padding-top: {{ padding_top | append: 'rem' }}; --section-padding-bottom: {{ padding_bottom | append: 'rem' }};{% endif %}">
  <div class="section">
    <div class="center">
      <a class="button button-primary" href="{{ section.settings.link | default: '#' }}">
        {{ section.settings.text }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Button",
  "tag": "section",
  "class": "button-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Button"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top_bottom",
      "label": "Section padding (top & bottom)",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "type": "checkbox",
      "id": "enable_padding_overrides",
      "label": "Override top/bottom padding",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.enable_padding_overrides == true }}",
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "visible_if": "{{ section.settings.enable_padding_overrides == true }}",
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
