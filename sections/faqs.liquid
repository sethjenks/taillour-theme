{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{% style %}
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color: var(--theme-bg-primary, #ffffff);
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
}
{{ section.id | prepend: '#' }} .section h1,
{{ section.id | prepend: '#' }} .section h2,
{{ section.id | prepend: '#' }} .section h3,
{{ section.id | prepend: '#' }} .section h4,
{{ section.id | prepend: '#' }} .section h5,
{{ section.id | prepend: '#' }} .section summary {
  color: var(--theme-text-primary, var(--font-primary-color));
}
{{ section.id | prepend: '#' }} .section .rte,
{{ section.id | prepend: '#' }} .section .rte p {
  color: var(--theme-text-secondary, var(--font-secondary-color));
}
{% endstyle %}

<div id="{{ section.id }}" class="section-wrap {{ scheme_class }}" style="color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));">
  <div class="section">
    <div class="center">
      <{{- section.settings.size }}>
        {{ section.settings.heading }}
      </{{- section.settings.size -}}>
      {%- if section.settings.show_description == true -%}
        <div class="rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>
  </div>
  <div class="section">
    {% for block in section.blocks %}
      <details{% if block.settings.open == true %} open{%- endif -%}>
        <summary>{{ block.settings.title }}</summary>
        <div class="rte">
          {{ block.settings.content }}
        </div>
      </details>
    {% endfor %}
  </div>
</div>


{% schema %}
{
  "name": "FAQs",
  "tag": "section",
  "class": "faqs-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "FAQs",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "title": "Vitae aut laudantium perspiciatis repellendus?",
            "content": "<p>Et vel id. Eos numquam sequi placeat et quasi corrupti assumenda. Officia numquam rerum. Excepturi velit tempora. Officiis illo distinctio quisquam minus. Enim iusto adipisci iure impedit. Accusamus doloribus soluta omnis fuga qui eius et.<\/p>"
          }
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Text",
      "default": "Frequently Asked Questions",
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_description == true }}",
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Alias blanditiis libero ut laboriosam. Velit, architecto atque repellat sapiente hic eius eos consequuntur perspiciatis quos. Veritatis eveniet esse minima repellendus!</p>"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Vitae aut laudantium perspiciatis repellendus?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Et vel id. Eos numquam sequi placeat et quasi corrupti assumenda. Officia numquam rerum. Excepturi velit tempora. Officiis illo distinctio quisquam minus. Enim iusto adipisci iure impedit. Accusamus doloribus soluta omnis fuga qui eius et.<\/p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
