{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- style -%}
#{{ section.id }}.footer-section {
  --footer-bg: var(--theme-bg-primary, #1a1523);
  --footer-text: var(--theme-text-primary, #ffffff);
  --footer-muted: var(--theme-text-secondary, #d3cce2);
}
#{{ section.id }}.footer-section:before {
  {% if section.settings.background_image != blank %}
  background-image: url({{ section.settings.background_image | image_url: width: 2200 }});
  {% endif %}
}
#{{ section.id }}.footer-section:after {
  background-image: linear-gradient(
    268deg,
    rgba(25, 21, 34, 0) 5%,
    rgba(25, 21, 34, 1) 95%
  );
}
{%- endstyle -%}

<section id="{{ section.id }}" class="footer-section section-wrap unpadded {{ scheme_class }}" style="--font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));">
  <div class="footer-section__inner section">
    <div class="footer-section__top">
      <div class="footer-section__brand">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 180 }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            alt="{{ section.settings.logo.alt | default: shop.name }}"
            loading="lazy"
          >
        {%- else -%}
          <span class="footer-section__brand-text">{{ shop.name }}</span>
        {%- endif -%}
      </div>

      <div class="footer-section__nav">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            <div class="footer-section__menu" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="footer-section__menu-title">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer-section__menu-list">
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li>
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a class="footer-section__cta" href="{{ section.settings.cta_link | default: '#' }}">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="footer-section__divider"></div>

    <div class="footer-section__bottom">
      <div class="footer-section__credits">
        <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
        {%- if section.settings.legal_menu != blank -%}
          <div class="footer-section__legal">
            {%- for link in linklists[section.settings.legal_menu].links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default theme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Theme",
      "default": "scheme_1"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Login"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Company"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Company"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
