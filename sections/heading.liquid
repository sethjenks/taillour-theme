{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- style -%}
{{ section.id | prepend: '#' }} .section h1,
{{ section.id | prepend: '#' }} .section h2,
{{ section.id | prepend: '#' }} .section h3,
{{ section.id | prepend: '#' }} .section h4,
{{ section.id | prepend: '#' }} .section h5 {
  color: var(--theme-text-primary, var(--font-primary-color));
}
{%- endstyle -%}

<div id="{{ section.id }}" class="section-wrap {{ scheme_class }}" style="color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));">
  <div class="section unpadded center">
    <{{- section.settings.size }} class="nomargin">
      {{- section.settings.title -}}
    </{{- section.settings.size -}}>
  </div>
</div>

{% schema %}
{
  "name": "Heading",
  "tag": "section",
  "class": "heading-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Heading"
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Text",
      "default": "Headline",
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
