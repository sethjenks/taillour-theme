{%- if section.settings.anchor_id != blank -%}<div id="{{ section.settings.anchor_id }}"></div>{%- endif -%}
{% unless section.settings.full_width == true %}
<div class="section">
{% endunless %}
  <hr/>
{% unless section.settings.full_width %}
</div>
{% endunless %}

{% schema %}
{
  "name": "Horizontal Rule",
  "tag": "section",
  "class": "hr-section section-wrap unpadded",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Horizontal Rule"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Enter a unique ID (e.g. 'about') so buttons can scroll to this section using '#about'."
    }
  ]
}
{% endschema %}
