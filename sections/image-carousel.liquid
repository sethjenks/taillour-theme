{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- assign position_mode = section.settings.position_mode | default: 'preset' -%}
{%- assign object_position_desktop = section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_desktop = section.settings.object_position_x | append: '% ' | append: section.settings.object_position_y | append: '%' -%}
{%- endif -%}
{%- assign object_position_mobile = section.settings.object_position_mobile | default: section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_mobile = section.settings.object_position_x_mobile | append: '% ' | append: section.settings.object_position_y_mobile | append: '%' -%}
{%- endif -%}
{%- style -%}
#{{ section.id }} {
  background-color: var(--theme-bg-primary, #ffffff);
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
  height: {{ section.settings.desktop_height | append: "vw" }};
}
#{{ section.id }} img {
  object-fit:{{ section.settings.object_fit }};
  object-position:{{ object_position_desktop }};
}
@media screen and (max-width: 768px) {
  #{{ section.id }} {
    height: {{ section.settings.mobile_height | append: "vw" }};
  }
  #{{ section.id }} img {
    object-position: {{ object_position_mobile }};
  }
}
{%-endstyle -%}

<div id="{{ section.id }}" class="swiper {{ scheme_class }}" style="--font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));">
  <div class="image-carousel-content swiper-wrapper">
    {%- for block in section.blocks -%}
      <div class="swiper-slide" data-swiper-autoplay="{{- block.settings.delay | times: 1000 -}}">
        {%- if block.settings.image == blank -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- else -%}
          {%- liquid
          assign image = block.settings.image
          assign image_width = 2000
          assign image_height = image_width | divided_by: image.aspect_ratio | ceil
          -%}
          {%- if section.settings.use_focal_point -%}
            {{ image | image_url: width: image_width | image_tag: alt: image.alt, loading: 'lazy' }}
          {%- else -%}
            <img src="{{image | image_url: width: image_width }}"
              width="{{ image_width }}"
              height="{{ image_height }}"
              alt="{{ image.alt }}"
            loading="lazy">
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_pagination == true -%}
    <div class="swiper-pagination"></div>
  {%- endif -%}

  {%- if section.settings.show_buttons == true -%}
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  {%- endif -%}
</div>

<script>
const swiper = new Swiper('{{ section.id | prepend: "#" }}', {
  // Optional parameters
  loop: {{ section.settings.loop }},
  autoplay: {{ section.settings.autoplay }},

  // If we need pagination
  pagination: {
    el: '.swiper-pagination',
  },

  // Navigation arrows
  navigation: {
    nextEl: '.swiper-button-next',
    prevEl: '.swiper-button-prev',
  },
  breakpoints: {
    "768": {
      slidesPerView: {{ section.settings.slides_per_view }}
    }
  }
});
</script>

{% schema %}
{
  "name": "Image Carousel (Full)",
  "tag": "section",
  "class": "image-carousel-section",
  "disabled_on": {
    "groups": ["header"]
