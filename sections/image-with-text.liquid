{%- assign image_width = 1024 -%}
{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- assign padding_default = section.settings.padding_top_bottom | default: 6 -%}
{%- assign padding_top = padding_default -%}
{%- assign padding_bottom = padding_default -%}
{%- if section.settings.enable_padding_overrides -%}
  {%- assign padding_top = section.settings.padding_top -%}
  {%- assign padding_bottom = section.settings.padding_bottom -%}
{%- endif -%}
{%- assign position_mode = section.settings.position_mode | default: 'preset' -%}
{%- assign object_position_desktop = section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_desktop = section.settings.object_position_x | append: '% ' | append: section.settings.object_position_y | append: '%' -%}
{%- endif -%}
{%- assign object_position_mobile = section.settings.object_position_mobile | default: section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_mobile = section.settings.object_position_x_mobile | append: '% ' | append: section.settings.object_position_y_mobile | append: '%' -%}
{%- endif -%}

{%- style -%}
.image-text-left .image-text-asset {
  order: -1;
}
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color: var(--theme-bg-primary, #ffffff);
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
}
{{ section.id | prepend: '#' }} .image-text-asset img {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.object_fit }};
  object-position: {{ object_position_desktop }};
  aspect-ratio: {{ section.settings.aspect_ratio }};
}
@media screen and (max-width: 768px) {
  {{ section.id | prepend: '#' }} .image-text-asset img {
    object-position: {{ object_position_mobile }};
  }
}
{%- endstyle -%}

<div id="{{ section.id }}" class="section-wrap {{ scheme_class }}"
  style="color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color)); --section-padding-default: {{ padding_default | append: 'rem' }};{% if section.settings.enable_padding_overrides %} --section-padding-top: {{ padding_top | append: 'rem' }}; --section-padding-bottom: {{ padding_bottom | append: 'rem' }};{% endif %}">
  <div class="section">
    {%- if section.settings.show_heading == true -%}
      <{{ section.settings.size }}>
        {{ section.settings.text }}
      </{{ section.settings.size }}>
    {%- endif -%}

    {%- if section.settings.show_description == true -%}
      <div class="rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    <div class="grid-2 middle image-text-{{ section.settings.image_position }}">
      <div class="image-text-content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <{{- block.settings.size }}>{{ block.settings.text }}</{{- block.settings.size -}}>
            {%- when 'text' -%}
              <div class="rte">
                {{ block.settings.text }}
              </div>
            {% when 'buttons' %}
            <p>
                <a class="button button-primary" href="{{ block.settings.button_link | default: '#' }}">
                  {{ block.settings.button_label }}
                </a>
              </p>
            {% when 'bullet_item' %}
              {%- capture icon_style -%}
                --bullet-icon-bg: {{ block.settings.icon_background | default: '#a87be6' }};
                --bullet-icon-border: {{ block.settings.icon_border_color | default: '#19212b' }};
                --bullet-icon-text: {{ block.settings.icon_text_color | default: '#ffffff' }};
                {%- if block.settings.icon_bg_image != blank -%}
                  background-image: url('{{ block.settings.icon_bg_image | image_url: width: 128 }}');
                {%- endif -%}
              {%- endcapture -%}

              <div class="bullet-item" {{ block.shopify_attributes }}>
                <div class="bullet-item__icon{% if block.settings.icon_shadow %} bullet-item__icon--shadow{% endif %}" style="{{ icon_style | strip }}">
                  {% unless block.settings.icon_text == blank %}
                    <span class="bullet-item__icon-text">{{ block.settings.icon_text }}</span>
                  {% endunless %}
                </div>
                <div class="bullet-item__content">
                  {% unless block.settings.title == blank %}
                    <div class="bullet-item__title">{{ block.settings.title }}</div>
                  {% endunless %}
                  {% unless block.settings.subtext == blank %}
                    <div class="bullet-item__subtext rte">{{ block.settings.subtext }}</div>
                  {% endunless %}
                </div>
              </div>
          {% endcase %}
        {%- endfor -%}
      </div>

      <div class="image-text-asset">
        <div>
          {% if section.settings.image == blank %}
            {{ 'collection-4' | placeholder_svg_tag: "placeholder" }}
          {% else %}
            {% assign image = section.settings.image %}
            {% if section.settings.use_focal_point %}
              {{ image | image_url: width: image_width | image_tag: alt: image.alt, loading: 'lazy' }}
            {% else %}
              <img src="{{ image | image_url: width: image_width }}"
                width="{{ image_width }}"
                height="{{ image_width | divided_by: image.aspect_ratio | ceil }}"
                alt="{{ image.alt }}"
                loading="lazy">
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image & Text",
  "tag": "section",
  "class": "image-text-section",
  "disabled_on": {
    "groups": ["header"]
