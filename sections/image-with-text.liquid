{%- assign image_width = 1024 -%}

{%- style -%}
.image-text-left .image-text-asset {
  order: -1;
}
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color:{{ section.settings.background | default: '#ffffff' }}
}
{%- endstyle -%}

<div id="{{ section.id }}" class="section-wrap"
  style="color:{{ section.settings.color | default:'inherit' }};">
  <div class="section">
    {%- if section.settings.show_heading == true -%}
      <{{ section.settings.size }}>
        {{ section.settings.text }}
      </{{ section.settings.size }}>
    {%- endif -%}

    {%- if section.settings.show_description == true -%}
      <div class="rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    <div class="grid-2 middle image-text-{{ section.settings.image_position }}">
      <div class="image-text-content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <{{- block.settings.size }}>{{ block.settings.text }}</{{- block.settings.size -}}>
            {%- when 'text' -%}
              <div class="rte">
                {{ block.settings.text }}
              </div>
            {% when 'buttons' %}
            <p>
                <a class="button button-primary" href="{{ block.settings.button_link | default: '#' }}">
                  {{ block.settings.button_label }}
                </a>
              </p>
            {% when 'bullet_item' %}
              {%- capture icon_style -%}
                --bullet-icon-bg: {{ block.settings.icon_background | default: '#a87be6' }};
                --bullet-icon-border: {{ block.settings.icon_border_color | default: '#19212b' }};
                --bullet-icon-text: {{ block.settings.icon_text_color | default: '#ffffff' }};
                {%- if block.settings.icon_bg_image != blank -%}
                  background-image: url('{{ block.settings.icon_bg_image | image_url: width: 128 }}');
                {%- endif -%}
              {%- endcapture -%}

              <div class="bullet-item" {{ block.shopify_attributes }}>
                <div class="bullet-item__icon{% if block.settings.icon_shadow %} bullet-item__icon--shadow{% endif %}" style="{{ icon_style | strip }}">
                  {% unless block.settings.icon_text == blank %}
                    <span class="bullet-item__icon-text">{{ block.settings.icon_text }}</span>
                  {% endunless %}
                </div>
                <div class="bullet-item__content">
                  {% unless block.settings.title == blank %}
                    <div class="bullet-item__title">{{ block.settings.title }}</div>
                  {% endunless %}
                  {% unless block.settings.subtext == blank %}
                    <div class="bullet-item__subtext rte">{{ block.settings.subtext }}</div>
                  {% endunless %}
                </div>
              </div>
          {% endcase %}
        {%- endfor -%}
      </div>

      <div class="image-text-asset">
        <div>
          {% if section.settings.image == blank %}
            {{ 'collection-4' | placeholder_svg_tag: "placeholder" }}
          {% else %}
            {% capture image_sizes %}
            width:100%; height:100%; object-fit: {{ section.settings.object_fit }}; object-position: {{ section.settings.object_position }}; aspect-ratio: {{ section.settings.aspect_ratio }}
            {% endcapture %}
            {% assign image = section.settings.image %}
            <img src="{{ image | image_url: width: image_width }}"
              width="{{ image_width }}"
              height="{{ image_width | divided_by: image.aspect_ratio | ceil }}"
              alt="{{ image.alt }}"
              style="{{- image_sizes -}}"
              loading="lazy">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image & Text",
  "tag": "section",
  "class": "image-text-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "inline_richtext",
      "id": "text",
      "label": "Heading",
      "default": "Headline",
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "select",
      "id": "size",
      "label": "Heading Size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_description == true }}",
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Alias blanditiis libero ut laboriosam. Velit, architecto atque repellat sapiente hic eius eos consequuntur perspiciatis quos. Veritatis eveniet esse minima repellendus!</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text Colour"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "object_position",
      "label": "Position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "options": [
        {
          "value": "1/1",
          "label": "1:1 (Square)"
        },
        {
          "value": "2/3",
          "label": "2:3 (Portrait)"
        },
        {
          "value": "4/5",
          "label": "4:5 (Portrait)"
        },
        {
          "value": "4/3",
          "label": "4:3 (Landscape)"
        },
        {
          "value": "16/9",
          "label": "16:9 (Landscape)"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Headline",
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Asperiores voluptatem rerum fuga assumenda similique voluptatem sapiente qui non voluptatibus.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    },
    {
      "type": "bullet_item",
      "name": "Bullet item",
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon text",
          "default": "01"
        },
        {
          "type": "image_picker",
          "id": "icon_bg_image",
          "label": "Icon background image"
        },
        {
          "type": "color",
          "id": "icon_background",
          "label": "Icon background color",
          "default": "#a87be6"
        },
        {
          "type": "color",
          "id": "icon_border_color",
          "label": "Icon border color",
          "default": "#19212b"
        },
        {
          "type": "color",
          "id": "icon_text_color",
          "label": "Icon text color",
          "default": "#ffffff"
        },
        {
          "type": "checkbox",
          "id": "icon_shadow",
          "label": "Show icon shadow",
          "default": true
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Make your picks"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext",
          "default": "<p>Choose a tournament. Make your picks before play begins.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image & Text",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
