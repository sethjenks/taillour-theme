{%- assign image_width = 1024 -%}
{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- assign padding_default = section.settings.padding_top_bottom | default: 6 -%}
{%- assign padding_top = padding_default -%}
{%- assign padding_bottom = padding_default -%}
{%- if section.settings.enable_padding_overrides -%}
  {%- assign padding_top = section.settings.padding_top -%}
  {%- assign padding_bottom = section.settings.padding_bottom -%}
{%- endif -%}
{%- assign family_absolute_enabled = section.settings.family_enable_absolute | default: true -%}
{%- assign family_position_mode = section.settings.family_position_mode | default: 'preset' -%}
{%- assign family_object_position_desktop = section.settings.family_object_position | default: 'center' -%}
{%- if family_position_mode == 'custom' -%}
  {%- assign family_object_position_desktop = section.settings.family_object_position_x | append: '% ' | append: section.settings.family_object_position_y | append: '%' -%}
{%- endif -%}
{%- assign family_object_position_mobile = section.settings.family_object_position_mobile | default: 'center' -%}
{%- if family_position_mode == 'custom' -%}
  {%- assign family_object_position_mobile = section.settings.family_object_position_x_mobile | append: '% ' | append: section.settings.family_object_position_y_mobile | append: '%' -%}
{%- endif -%}
{%- assign family_layer_x = section.settings.family_x | append: '%' -%}
{%- assign family_layer_y = section.settings.family_y | append: '%' -%}
{%- assign family_layer_width = section.settings.family_width | append: '%' -%}
{%- assign family_layer_height = section.settings.family_height | append: '%' -%}
{%- assign family_layer_x_mobile = section.settings.family_x_mobile | append: '%' -%}
{%- assign family_layer_y_mobile = section.settings.family_y_mobile | append: '%' -%}
{%- assign family_layer_width_mobile = section.settings.family_width_mobile | append: '%' -%}
{%- assign family_layer_height_mobile = section.settings.family_height_mobile | append: '%' -%}
{%- if family_absolute_enabled == false -%}
  {%- assign family_layer_x = '50%' -%}
  {%- assign family_layer_y = '50%' -%}
  {%- assign family_layer_width = '100%' -%}
  {%- assign family_layer_height = '100%' -%}
  {%- assign family_layer_x_mobile = '50%' -%}
  {%- assign family_layer_y_mobile = '50%' -%}
  {%- assign family_layer_width_mobile = '100%' -%}
  {%- assign family_layer_height_mobile = '100%' -%}
{%- endif -%}

{%- assign app_absolute_enabled = section.settings.app_enable_absolute | default: true -%}
{%- assign app_position_mode = section.settings.app_position_mode | default: 'preset' -%}
{%- assign app_object_position_desktop = section.settings.app_object_position | default: 'center' -%}
{%- if app_position_mode == 'custom' -%}
  {%- assign app_object_position_desktop = section.settings.app_object_position_x | append: '% ' | append: section.settings.app_object_position_y | append: '%' -%}
{%- endif -%}
{%- assign app_object_position_mobile = section.settings.app_object_position_mobile | default: 'center' -%}
{%- if app_position_mode == 'custom' -%}
  {%- assign app_object_position_mobile = section.settings.app_object_position_x_mobile | append: '% ' | append: section.settings.app_object_position_y_mobile | append: '%' -%}
{%- endif -%}
{%- assign app_layer_x = section.settings.app_x | append: '%' -%}
{%- assign app_layer_y = section.settings.app_y | append: '%' -%}
{%- assign app_layer_width = section.settings.app_width | append: '%' -%}
{%- assign app_layer_height = section.settings.app_height | append: '%' -%}
{%- assign app_layer_x_mobile = section.settings.app_x_mobile | append: '%' -%}
{%- assign app_layer_y_mobile = section.settings.app_y_mobile | append: '%' -%}
{%- assign app_layer_width_mobile = section.settings.app_width_mobile | append: '%' -%}
{%- assign app_layer_height_mobile = section.settings.app_height_mobile | append: '%' -%}
{%- if app_absolute_enabled == false -%}
  {%- assign app_layer_x = '50%' -%}
  {%- assign app_layer_y = '50%' -%}
  {%- assign app_layer_width = '100%' -%}
  {%- assign app_layer_height = '100%' -%}
  {%- assign app_layer_x_mobile = '50%' -%}
  {%- assign app_layer_y_mobile = '50%' -%}
  {%- assign app_layer_width_mobile = '100%' -%}
  {%- assign app_layer_height_mobile = '100%' -%}
{%- endif -%}
{%- assign family_object_fit = section.settings.family_object_fit | default: 'contain' -%}
{%- assign app_object_fit = section.settings.app_object_fit | default: 'contain' -%}

{%- style -%}
.image-text-left .image-text-asset {
  order: -1;
}
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color: var(--theme-bg-primary, #ffffff);
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
}
{{ section.id | prepend: '#' }}.section-wrap {
  --image-text-text-columns: {{ section.settings.text_columns | default: 4 }}fr;
  --image-text-media-columns: {{ section.settings.media_columns | default: 8 }}fr;
}
@media screen and (min-width: 769px) {
  {{ section.id | prepend: '#' }} .grid-2 {
    grid-template-columns: var(--image-text-text-columns) var(--image-text-media-columns);
  }
}
{{ section.id | prepend: '#' }} .image-text-asset--layered {
  --image-text-asset-ratio: {{ section.settings.aspect_ratio }};
  --image-text-family-x: {{ family_layer_x }};
  --image-text-family-y: {{ family_layer_y }};
  --image-text-family-width: {{ family_layer_width }};
  --image-text-family-height: {{ family_layer_height }};
  --image-text-app-x: {{ app_layer_x }};
  --image-text-app-y: {{ app_layer_y }};
  --image-text-app-width: {{ app_layer_width }};
  --image-text-app-height: {{ app_layer_height }};
  --image-text-blob-size: {{ section.settings.blob_size | append: '%' }};
  --image-text-blob-x: {{ section.settings.blob_x | append: '%' }};
  --image-text-blob-y: {{ section.settings.blob_y | append: '%' }};
  --image-text-blob-color: {{ section.settings.blob_color }};
  --image-text-blob-blur: {{ section.settings.blob_blur | append: 'px' }};
  --image-text-blob-opacity: {{ section.settings.blob_opacity | divided_by: 100.0 }};
}
{{ section.id | prepend: '#' }} .image-text-layer--family img {
  object-fit: {{ family_object_fit }};
  object-position: {{ family_object_position_desktop }};
}
{{ section.id | prepend: '#' }} .image-text-layer--app img {
  object-fit: {{ app_object_fit }};
  object-position: {{ app_object_position_desktop }};
}
{{ section.id | prepend: '#' }} .image-text-content h1,
{{ section.id | prepend: '#' }} .image-text-content h2,
{{ section.id | prepend: '#' }} .image-text-content h3,
{{ section.id | prepend: '#' }} .image-text-content h4,
{{ section.id | prepend: '#' }} .image-text-content h5 {
  color: var(--theme-text-primary, var(--font-primary-color));
}
{{ section.id | prepend: '#' }} .image-text-content .rte,
{{ section.id | prepend: '#' }} .image-text-content .rte p {
  color: var(--theme-text-secondary, var(--font-secondary-color));
}
@media screen and (max-width: 768px) {
  {{ section.id | prepend: '#' }} .image-text-asset--layered {
    --image-text-family-x: {{ family_layer_x_mobile }};
    --image-text-family-y: {{ family_layer_y_mobile }};
    --image-text-family-width: {{ family_layer_width_mobile }};
    --image-text-family-height: {{ family_layer_height_mobile }};
    --image-text-app-x: {{ app_layer_x_mobile }};
    --image-text-app-y: {{ app_layer_y_mobile }};
    --image-text-app-width: {{ app_layer_width_mobile }};
    --image-text-app-height: {{ app_layer_height_mobile }};
  }
  {{ section.id | prepend: '#' }} .image-text-layer--family img {
    object-position: {{ family_object_position_mobile }};
  }
  {{ section.id | prepend: '#' }} .image-text-layer--app img {
    object-position: {{ app_object_position_mobile }};
  }
}
{%- endstyle -%}

<div id="{{ section.id }}" class="section-wrap {{ scheme_class }}"
  style="color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color)); --section-padding-default: {{ padding_default | append: 'rem' }};{% if section.settings.enable_padding_overrides %} --section-padding-top: {{ padding_top | append: 'rem' }}; --section-padding-bottom: {{ padding_bottom | append: 'rem' }};{% endif %}">
  <div class="section">
    {%- if section.settings.show_heading == true -%}
      <{{ section.settings.size }}>
        {{ section.settings.text }}
      </{{ section.settings.size }}>
    {%- endif -%}

    {%- if section.settings.show_description == true -%}
      <div class="rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    <div class="grid-2 middle image-text-{{ section.settings.image_position }}">
      <div class="image-text-content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <{{- block.settings.size }}>{{ block.settings.text }}</{{- block.settings.size -}}>
            {%- when 'text' -%}
              <div class="rte">
                {{ block.settings.text }}
              </div>
            {% when 'buttons' %}
            <p>
                <a class="button button-primary" href="{{ block.settings.button_link | default: '#' }}">
                  {{ block.settings.button_label }}
                </a>
              </p>
            {% when 'bullet_item' %}
              {%- capture icon_style -%}
                --bullet-icon-bg: {{ block.settings.icon_background | default: '#a87be6' }};
                --bullet-icon-border: {{ block.settings.icon_border_color | default: '#19212b' }};
                --bullet-icon-text: {{ block.settings.icon_text_color | default: '#ffffff' }};
                {%- if block.settings.icon_bg_image != blank -%}
                  background-image: url('{{ block.settings.icon_bg_image | image_url: width: 128 }}');
                {%- endif -%}
              {%- endcapture -%}

              <div class="bullet-item" {{ block.shopify_attributes }}>
                <div class="bullet-item__icon{% if block.settings.icon_shadow %} bullet-item__icon--shadow{% endif %}" style="{{ icon_style | strip }}">
                  {% unless block.settings.icon_text == blank %}
                    <span class="bullet-item__icon-text">{{ block.settings.icon_text }}</span>
                  {% endunless %}
                </div>
                <div class="bullet-item__content">
                  {% unless block.settings.title == blank %}
                    <div class="bullet-item__title">{{ block.settings.title }}</div>
                  {% endunless %}
                  {% unless block.settings.subtext == blank %}
                    <div class="bullet-item__subtext rte">{{ block.settings.subtext }}</div>
                  {% endunless %}
                </div>
              </div>
          {% endcase %}
        {%- endfor -%}
      </div>

      {%- assign family_image = section.settings.family_image -%}
      {%- assign app_image = section.settings.app_image -%}
      {%- assign family_use_focal_point = section.settings.family_use_focal_point | default: section.settings.use_focal_point -%}
      {%- assign app_use_focal_point = section.settings.app_use_focal_point | default: section.settings.use_focal_point -%}

      <div class="image-text-asset image-text-asset--layered">
        {%- if section.settings.blob_enable -%}
          <span class="image-text-blob" aria-hidden="true"></span>
        {%- endif -%}

        {%- if app_image != blank -%}
          <div class="image-text-layer image-text-layer--app">
            {%- assign image = app_image -%}
            {%- if app_use_focal_point -%}
              {{ image | image_url: width: image_width | image_tag: alt: image.alt, loading: 'lazy' }}
            {%- else -%}
              <img
                src="{{ image | image_url: width: image_width }}"
                width="{{ image_width }}"
                height="{{ image_width | divided_by: image.aspect_ratio | ceil }}"
                alt="{{ image.alt }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if family_image != blank -%}
          <div class="image-text-layer image-text-layer--family">
            {%- assign image = family_image -%}
            {%- if family_use_focal_point -%}
              {{ image | image_url: width: image_width | image_tag: alt: image.alt, loading: 'lazy' }}
            {%- else -%}
              <img
                src="{{ image | image_url: width: image_width }}"
                width="{{ image_width }}"
                height="{{ image_width | divided_by: image.aspect_ratio | ceil }}"
                alt="{{ image.alt }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if family_image == blank and app_image == blank -%}
          {{ 'collection-4' | placeholder_svg_tag: "placeholder" }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image & Text",
  "tag": "section",
  "class": "image-text-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "inline_richtext",
      "id": "text",
      "label": "Heading",
      "default": "Headline"
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "select",
      "id": "size",
      "label": "Heading Size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
