{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- assign position_mode = section.settings.position_mode | default: 'preset' -%}
{%- assign object_position_desktop = section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_desktop = section.settings.object_position_x | append: '% ' | append: section.settings.object_position_y | append: '%' -%}
{%- endif -%}
{%- assign object_position_mobile = section.settings.object_position_mobile | default: section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_mobile = section.settings.object_position_x_mobile | append: '% ' | append: section.settings.object_position_y_mobile | append: '%' -%}
{%- endif -%}
{%- style -%}
#{{ section.id }}.large-media-section.section-wrap:before {
  background: linear-gradient(
    90deg,
    var(--theme-bg-primary, #ffffff) 0%,
    var(--theme-bg-primary, #ffffff) 45%,
    var(--theme-bg-secondary, #f4ff9b) 100%
  );
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
}
#{{ section.id }}.large-media-section.section-wrap {
  --large-media-align: {{ section.settings.vertical_alignment | default: 'center' }};
}
#{{ section.id }} .large-media-section__inner {
  align-items: var(--large-media-align);
}
#{{ section.id }} .large-media-section__media img {
  object-fit: {{ section.settings.object_fit }};
  object-position: {{ object_position_desktop }};
}
@media screen and (max-width: 768px) {
  #{{ section.id }} .large-media-section__media img {
    object-position: {{ object_position_mobile }};
  }
}
{%- endstyle -%}

<div
  id="{{ section.id }}"
  class="section-wrap large-media-section {{ scheme_class }}"
  style="color: var(--theme-text-primary, #1a1523); --section-body-color: var(--theme-text-secondary, #66626e); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));"
>
  {%- if section.settings.anchor_id != blank -%}<div id="{{ section.settings.anchor_id }}"></div>{%- endif -%}
  <div class="section large-media-section__inner">
    <div class="large-media-section__text">
      {%- if section.settings.title != blank -%}
        <h2 class="large-media-section__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="large-media-section__body rte">
          {{ section.settings.body }}
        </div>
      {%- endif -%}
    </div>
    <div class="large-media-section__media">
      <div class="large-media-section__media-inner">
        {%- if section.settings.image == blank -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- else -%}
          {%- assign image = section.settings.image -%}
          {%- if section.settings.use_focal_point -%}
            {{ image | image_url: width: 1600 | image_tag: alt: image.alt, loading: 'lazy' }}
          {%- else -%}
            <img
              src="{{ image | image_url: width: 1600 }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              alt="{{ image.alt }}"
              loading="lazy"
            >
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Large Media Split",
  "tag": "section",
  "class": "large-media-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Friendly competition for all ages."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Everyone can be part of the dub club! Join our community of sports fans who enjoy predicting winners and competing for the top spot on the leaderboard.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment (desktop)",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Theme"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "checkbox",
      "id": "use_focal_point",
      "label": "Use image focal point",
      "default": false
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "object_position",
      "label": "Position",
      "options": [
        {
          "value": "left top",
          "label": "Top left"
        },
        {
          "value": "center top",
          "label": "Top center"
        },
        {
          "value": "right top",
          "label": "Top right"
        },
        {
          "value": "left center",
          "label": "Center left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Center right"
        },
        {
          "value": "left bottom",
          "label": "Bottom left"
        },
        {
          "value": "center bottom",
          "label": "Bottom center"
        },
        {
          "value": "right bottom",
          "label": "Bottom right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "position_mode",
      "label": "Position mode",
      "options": [
        {
          "value": "preset",
          "label": "Preset positions"
        },
        {
          "value": "custom",
          "label": "Custom X/Y"
        }
      ],
      "default": "preset"
    },
    {
      "type": "range",
      "id": "object_position_x",
      "label": "Position X (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.position_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "object_position_y",
      "label": "Position Y (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.position_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "object_position_mobile",
      "label": "Position (mobile)",
      "options": [
        {
          "value": "left top",
          "label": "Top left"
        },
        {
          "value": "center top",
          "label": "Top center"
        },
        {
          "value": "right top",
          "label": "Top right"
        },
        {
          "value": "left center",
          "label": "Center left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Center right"
        },
        {
          "value": "left bottom",
          "label": "Bottom left"
        },
        {
          "value": "center bottom",
          "label": "Bottom center"
        },
        {
          "value": "right bottom",
          "label": "Bottom right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "object_position_x_mobile",
      "label": "Position X (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.position_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "object_position_y_mobile",
      "label": "Position Y (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.position_mode == 'custom' }}"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Enter a unique ID (e.g. 'about') so buttons can scroll to this section using '#about'."
    }
  ],
  "presets": [
    {
      "name": "Large Media Split"
    }
  ]
}
{% endschema %}
