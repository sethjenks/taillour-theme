<style>
#collection {
  display: grid;
  grid-template-columns: 200px auto;
  gap: 3rem;
}
#collection aside h3,
#collection aside p {
  margin-top: 0;
  margin-bottom: 0;
}
#collection aside > div {
  margin-bottom: 1.5rem;
}
{{ section.id | prepend: '#' }} .products-grid {
  --product-card-min: 274px;
  grid-template-columns: repeat(auto-fit, minmax(var(--product-card-min), 1fr));
}
</style>

<div id="{{ section.id }}" class="section-wrap">
  <div id="collection" class="section">
    <aside>
      <div class="flex middle">
        <h3>Filters</h3>
        <p>
          <em><a href="{{ collection.url }}?sort_by={{ collection.sort_by }}">Clear all</a></em>
        </p>
      </div>
      {% render 'collection-filters' %}
    </aside>

    {% paginate collection.products by section.settings.limit %}
    <div id="collection-results">
      <div class="section">
        <p>{{ collection.products_count }} products</p>

        {% if collection.products_count > 0 %}
          <div class="products-grid">
            {% liquid
            for product in collection.products
              render 'product-card', product: product
            endfor
            %}
          </div>
        {% else %}
          <p>No products match the selected filters. Try adjusting or <a href="{{ collection.url }}">clearing all filters</a>.</p>
        {% endif %}
      </div>

      {% if collection.products_count > 0 %}
        <div class="section">
          <div>
            {% render 'pagination', paginate: paginate %}
          </div>
        </div>
      {% endif %}
    </div>
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Products",
  "tag": "section",
  "class": "collection-products-section",
  "templates": ["collection"],
  "settings": [
    {
      "type": "paragraph",
      "content": "Display current collection's products."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "info": "Limit the number of products displayed per page.",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products Per Row",
      "info": "Number of products per row.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
