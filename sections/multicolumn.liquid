{% liquid
assign image_width = 600
assign columns = 0
for block in section.blocks
  if block.type != 'header'
    assign columns = columns | plus: 1
  endif
endfor
assign active_scheme = settings.default_color_scheme
if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank
  assign active_scheme = section.settings.color_scheme
endif
assign scheme_class = ''
if active_scheme != blank
  assign scheme_class = 'color-' | append: active_scheme.id
endif
assign padding_default = section.settings.padding_top_bottom | default: 6
assign padding_top = padding_default
assign padding_bottom = padding_default
if section.settings.enable_padding_overrides
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
endif
%}

{% style %}
.column-section {
  display: grid;
  gap: var(--column-section-gap);
}
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color: var(--theme-bg-primary, #ffffff);
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
}
{{ section.id | prepend: '#' }} .column-section {
  grid-template-columns: repeat({{ columns }}, 1fr);
}
{{ section.id | prepend: '#' }} .column-section .column-image {
  width: 100%;
  height: 100%;
  max-width: var(--column-image-max-width, 100%);
  object-fit: var(--column-object-fit, cover);
  object-position: var(--column-object-position-desktop, center);
  aspect-ratio: var(--column-image-aspect-ratio);
}
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper {
  display: flex;
  margin-bottom: var(--column-image-gap, 0.5rem);
}
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper.align-left {
  justify-content: flex-start;
}
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper.center {
  justify-content: center;
}
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper.align-right {
  justify-content: flex-end;
}
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper + h1,
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper + h2,
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper + h3,
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper + h4,
{{ section.id | prepend: '#' }} .column-section .column-image-wrapper + h5 {
  margin-top: 0;
}
{{ section.id | prepend: '#' }} .column-section h1,
{{ section.id | prepend: '#' }} .column-section h2,
{{ section.id | prepend: '#' }} .column-section h3,
{{ section.id | prepend: '#' }} .column-section h4,
{{ section.id | prepend: '#' }} .column-section h5 {
  color: var(--theme-text-primary, var(--font-primary-color));
}
{{ section.id | prepend: '#' }} .column-section .rte,
{{ section.id | prepend: '#' }} .column-section .rte p {
  color: var(--theme-text-secondary, var(--font-secondary-color));
}
{{ section.id | prepend: '#' }} .section h1,
{{ section.id | prepend: '#' }} .section h2,
{{ section.id | prepend: '#' }} .section h3,
{{ section.id | prepend: '#' }} .section h4,
{{ section.id | prepend: '#' }} .section h5 {
  color: var(--theme-text-primary, var(--font-primary-color));
}
{{ section.id | prepend: '#' }} .section .rte,
{{ section.id | prepend: '#' }} .section .rte p {
  color: var(--theme-text-secondary, var(--font-secondary-color));
}
@media screen and (max-width: 768px) {
  {{ section.id | prepend: '#' }} .column-section .column-image {
    object-position: var(--column-object-position-mobile, center);
  }
}
{% endstyle %}

<div id="{{ section.id }}" class="section-wrap {{ scheme_class }}" style="color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color)); --section-padding-default: {{ padding_default | append: 'rem' }};{% if section.settings.enable_padding_overrides %} --section-padding-top: {{ padding_top | append: 'rem' }}; --section-padding-bottom: {{ padding_bottom | append: 'rem' }};{% endif %}">
  {%- if section.settings.show_heading == true or section.settings.show_description == true -%}
    <div class="section">
      {%- if section.settings.show_heading == true -%}
        <{{ section.settings.size }}>
          {{ section.settings.text }}
        </{{ section.settings.size }}>
      {%- endif -%}

      {%- if section.settings.show_description == true -%}
        <div class="rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'header' %}
        {%- assign title_alignment = block.settings.title_alignment | default: 'align-left' -%}
        {%- assign subtitle_alignment = block.settings.subtitle_alignment | default: 'align-left' -%}
        {%- assign button_alignment = block.settings.button_alignment | default: 'align-left' -%}
        <div class="section" {{ block.shopify_attributes }}>
          {% unless block.settings.title == blank %}
            <{{ block.settings.title_size }} class="{{ title_alignment }}">
              {{ block.settings.title }}
            </{{ block.settings.title_size }}>
          {% endunless %}

          {% unless block.settings.subtitle == blank %}
            <div class="rte {{ subtitle_alignment }}">
              {{ block.settings.subtitle }}
            </div>
          {% endunless %}

          {% if block.settings.show_button == true and block.settings.button_label != blank %}
            <div class="{{ button_alignment }}">
              <a class="button button-primary" href="{{ block.settings.button_link | default: '#' }}">
                {{ block.settings.button_label }}
              </a>
            </div>
          {% endif %}
        </div>
    {% endcase %}
  {% endfor %}

  <div class="section column-section{% if section.settings.swipe_on_mobile == true %} scrolly{% endif %}">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'column' %}
          {% assign image_height = image_width | divided_by: block.settings.image.aspect_ratio | ceil %}
          {%- assign column_alignment = block.settings.alignment | default: 'align-left' -%}
          {%- assign image_alignment = block.settings.image_alignment | default: 'center' -%}
          <div class="{{ column_alignment }}" {{ block.shopify_attributes }}>
            {% if block.settings.show_image == true %}
              {% if block.settings.image == blank %}
                <div class="column-image-wrapper {{ image_alignment }}">
                  {{ 'collection-1' | placeholder_svg_tag: "placeholder" }}
                </div>
              {% else %}
                {%- assign position_mode = block.settings.position_mode | default: 'preset' -%}
                {%- assign object_position_desktop = block.settings.object_position -%}
                {%- if position_mode == 'custom' -%}
                  {%- assign object_position_desktop = block.settings.object_position_x | append: '% ' | append: block.settings.object_position_y | append: '%' -%}
                {%- endif -%}
                {%- assign object_position_mobile = block.settings.object_position_mobile | default: block.settings.object_position -%}
                {%- if position_mode == 'custom' -%}
                  {%- assign object_position_mobile = block.settings.object_position_x_mobile | append: '% ' | append: block.settings.object_position_y_mobile | append: '%' -%}
                {%- endif -%}
                {%- capture image_styles -%}
                --column-object-fit: {{ block.settings.object_fit }};
                --column-object-position-desktop: {{ object_position_desktop }};
                --column-object-position-mobile: {{ object_position_mobile }};
                --column-image-aspect-ratio: {{ block.settings.aspect_ratio }};
                --column-image-max-width: {{ block.settings.image_max_width | append: 'px' }};
                {%- endcapture -%}
                <div class="column-image-wrapper {{ image_alignment }}">
                  {% if block.settings.use_focal_point %}
                    {{ block.settings.image | image_url: width: image_width | image_tag: alt: block.settings.image.alt, loading: 'lazy', class: 'column-image', style: image_styles | strip }}
                  {% else %}
                    <img class="column-image" src="{{ block.settings.image | image_url: width: image_width }}"
                      width="{{ image_width }}"
                      height="{{ image_height }}"
                      style="{{- image_styles | strip -}}"
                      alt="{{- block.settings.image.alt -}}"
                      loading="lazy">
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}

            {% unless block.settings.text == blank %}
              <{{- block.settings.size }}>
                {{- block.settings.text -}}
              </{{- block.settings.size -}}>
            {% endunless %}

            {% unless block.settings.content == blank %}
              <div class="rte">
                {{- block.settings.content -}}
              </div>
            {% endunless %}

            {% if block.settings.show_button == true %}
              <div>
                <p>
                  <a class="button button-primary" href="{{ block.settings.button_link | default: '#' }}">
                    {{ block.settings.button_label | default: "Button Label" }}
                  </a>
                </p>
              </div>
            {% endif %}
          </div>
        {% when 'bullet_item' %}
          {%- capture icon_style -%}
            --bullet-icon-bg: {{ block.settings.icon_background | default: '#a87be6' }};
            --bullet-icon-border: {{ block.settings.icon_border_color | default: '#19212b' }};
            --bullet-icon-text: {{ block.settings.icon_text_color | default: '#ffffff' }};
            {%- if block.settings.icon_bg_image != blank -%}
              background-image: url('{{ block.settings.icon_bg_image | image_url: width: 128 }}');
            {%- endif -%}
          {%- endcapture -%}

          <div class="bullet-item" {{ block.shopify_attributes }}>
            <div class="bullet-item__icon{% if block.settings.icon_shadow %} bullet-item__icon--shadow{% endif %}" style="{{ icon_style | strip }}">
              {% unless block.settings.icon_text == blank %}
                <span class="bullet-item__icon-text">{{ block.settings.icon_text }}</span>
              {% endunless %}
            </div>
            <div class="bullet-item__content">
              {% unless block.settings.title == blank %}
                <div class="bullet-item__title">{{ block.settings.title }}</div>
              {% endunless %}
              {% unless block.settings.subtext == blank %}
                <div class="bullet-item__subtext rte">{{ block.settings.subtext }}</div>
              {% endunless %}
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Columns/Richtext",
  "tag": "section",
  "class": "columns-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Columns/Richtext",
      "blocks": [
        {
          "type": "column"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "A section made up of a maximum of 4 columns. Each column can have an image, heading, content and button."
    },
    {
      "type": "paragraph",
      "content": "This can also be used to display a single column that fills the width of the website."
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "padding_top_bottom",
      "label": "Section padding (top & bottom)",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "type": "checkbox",
      "id": "enable_padding_overrides",
      "label": "Override top/bottom padding",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.enable_padding_overrides == true }}",
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "visible_if": "{{ section.settings.enable_padding_overrides == true }}",
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "inline_richtext",
      "id": "text",
      "label": "Heading",
      "default": "Headline",
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "select",
      "id": "size",
      "label": "Heading Size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_description == true }}",
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Alias blanditiis libero ut laboriosam. Velit, architecto atque repellat sapiente hic eius eos consequuntur perspiciatis quos. Veritatis eveniet esse minima repellendus!</p>"
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "Swipe on mobile",
      "info": "Makes the columns left to right swipeable on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "header",
      "name": "Header",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Headline"
        },
        {
          "type": "select",
          "id": "title_alignment",
          "label": "Title alignment",
          "options": [
            {
              "value": "align-left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "align-right",
              "label": "Right"
            }
          ],
          "default": "align-left"
        },
        {
          "type": "select",
          "id": "title_size",
          "label": "Title size",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        },
