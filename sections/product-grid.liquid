{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- assign padding_default = section.settings.padding_top_bottom | default: 6 -%}
{%- assign padding_top = padding_default -%}
{%- assign padding_bottom = padding_default -%}
{%- assign mobile_layout = section.settings.mobile_layout | default: 'grid' -%}
{%- if section.settings.enable_padding_overrides -%}
  {%- assign padding_top = section.settings.padding_top -%}
  {%- assign padding_bottom = section.settings.padding_bottom -%}
{%- endif -%}
<style>
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color: var(--theme-bg-primary, #ffffff);
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
}
{{ section.id | prepend: '#' }}.section-wrap {
  --product-blob-1-size: {{ section.settings.blob1_size | append: "vw" }};
  --product-blob-1-x: {{ section.settings.blob1_x | append: "%" }};
  --product-blob-1-y: {{ section.settings.blob1_y | append: "%" }};
  --product-blob-1-color: {{ section.settings.blob1_color }};
  --product-blob-1-blur: {{ section.settings.blob1_blur | append: "px" }};
  --product-blob-1-opacity: {{ section.settings.blob1_opacity | divided_by: 100.0 }};
  --product-blob-2-size: {{ section.settings.blob2_size | append: "vw" }};
  --product-blob-2-x: {{ section.settings.blob2_x | append: "%" }};
  --product-blob-2-y: {{ section.settings.blob2_y | append: "%" }};
  --product-blob-2-color: {{ section.settings.blob2_color }};
  --product-blob-2-blur: {{ section.settings.blob2_blur | append: "px" }};
  --product-blob-2-opacity: {{ section.settings.blob2_opacity | divided_by: 100.0 }};
}
{{ section.id | prepend: '#' }} .products-grid {
  grid-template-columns: repeat({{ section.settings.products_per_row }}, 1fr);
}
</style>

<div id="{{ section.id }}" class="section-wrap {{ scheme_class }} product-grid--mobile-{{ mobile_layout }}" data-mobile-layout="{{ mobile_layout }}" style="color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color)); --section-padding-default: {{ padding_default | append: 'rem' }};{% if section.settings.enable_padding_overrides %} --section-padding-top: {{ padding_top | append: 'rem' }}; --section-padding-bottom: {{ padding_bottom | append: 'rem' }};{% endif %}">
  {%- if section.settings.blob1_enable or section.settings.blob2_enable -%}
    <div class="product-grid__blobs" aria-hidden="true">
      {%- if section.settings.blob1_enable -%}
        <span class="product-grid__blob product-grid__blob--one"></span>
      {%- endif -%}
      {%- if section.settings.blob2_enable -%}
        <span class="product-grid__blob product-grid__blob--two"></span>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="section">
    {% if section.settings.show_heading == true %}
      <{{ section.settings.size }}>
        {{ section.settings.text }}
      </{{ section.settings.size }}>
    {% endif %}

    {%- if section.settings.show_description == true -%}
      <div class="rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    {% assign collection_handle = section.settings.collection | default: "home" %}

    {%- if mobile_layout == 'carousel' -%}
      <div class="products-grid" data-device="desktop">
        {% liquid
        for product in collections[collection_handle].products limit: section.settings.limit
          render 'product-card', product: product
        endfor
        %}
      </div>
      <div id="{{ section.id }}-mobile-carousel" class="products-grid-swiper swiper" data-device="mobile">
        <div class="swiper-wrapper">
          {% liquid
          for product in collections[collection_handle].products limit: section.settings.limit
            echo '<div class="swiper-slide">'
            render 'product-card', product: product
            echo '</div>'
          endfor
          %}
        </div>
      </div>
    {%- else -%}
      <div class="products-grid">
        {% liquid
        for product in collections[collection_handle].products limit: section.settings.limit
          render 'product-card', product: product
        endfor
        %}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if mobile_layout == 'carousel' -%}
  <script>
    (() => {
      const loadSwiper = () => {
        if (window.Swiper) return Promise.resolve();
        if (window.__swiperLoaderPromise) return window.__swiperLoaderPromise;
        window.__swiperLoaderPromise = new Promise((resolve, reject) => {
          if (!document.querySelector('link[data-swiper-css]')) {
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
            link.dataset.swiperCss = 'true';
            document.head.appendChild(link);
          }
          let script = document.querySelector('script[data-swiper-js]');
          if (!script) {
            script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
            script.defer = true;
            script.dataset.swiperJs = 'true';
            document.head.appendChild(script);
          }
          script.addEventListener('load', () => resolve());
          script.addEventListener('error', () => reject());
        });
        return window.__swiperLoaderPromise;
      };
      const container = document.querySelector('#{{ section.id }}-mobile-carousel');
      if (!container) return;
      let swiperInstance = null;
      const mql = window.matchMedia('(max-width: 768px)');
      const initSwiper = () => {
        if (!mql.matches) {
          if (swiperInstance) {
            swiperInstance.destroy(true, true);
            swiperInstance = null;
          }
          return;
        }
        if (swiperInstance) return;
        swiperInstance = new Swiper(container, {
          slidesPerView: 1.2,
          spaceBetween: 16,
          watchOverflow: true
        });
      };
      loadSwiper().then(() => {
        initSwiper();
        if (mql.addEventListener) {
          mql.addEventListener('change', initSwiper);
        } else {
          mql.addListener(initSwiper);
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Products",
  "tag": "section",
  "class": "collection-products-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Products"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "padding_top_bottom",
      "label": "Section padding (top & bottom)",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "type": "checkbox",
      "id": "enable_padding_overrides",
      "label": "Override top/bottom padding",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.enable_padding_overrides == true }}",
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "visible_if": "{{ section.settings.enable_padding_overrides == true }}",
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 6,
      "unit": "rem"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Blobs"
    },
    {
      "type": "checkbox",
      "id": "blob1_enable",
      "label": "Show Blob 1",
      "default": false
    },
    {
      "type": "color",
      "id": "blob1_color",
      "label": "Blob 1 color",
      "default": "#b68bff"
    },
    {
      "type": "range",
      "id": "blob1_size",
      "label": "Blob 1 size",
      "min": 10,
      "max": 80,
      "step": 1,
      "default": 40,
      "unit": "vw"
    },
    {
      "type": "range",
      "id": "blob1_x",
      "label": "Blob 1 position X",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 75,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "blob1_y",
      "label": "Blob 1 position Y",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 55,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "blob1_blur",
      "label": "Blob 1 blur",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "blob1_opacity",
      "label": "Blob 1 opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "blob2_enable",
      "label": "Show Blob 2",
      "default": false
    },
    {
      "type": "color",
      "id": "blob2_color",
      "label": "Blob 2 color",
      "default": "#f4ff85"
    },
    {
      "type": "range",
      "id": "blob2_size",
      "label": "Blob 2 size",
      "min": 10,
      "max": 80,
      "step": 1,
      "default": 36,
      "unit": "vw"
    },
    {
      "type": "range",
      "id": "blob2_x",
      "label": "Blob 2 position X",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 55,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "blob2_y",
      "label": "Blob 2 position Y",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "blob2_blur",
      "label": "Blob 2 blur",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "blob2_opacity",
      "label": "Blob 2 opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "inline_richtext",
      "id": "text",
      "label": "Heading",
      "default": "Headline",
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "select",
      "id": "size",
      "label": "Heading Size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_description == true }}",
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Alias blanditiis libero ut laboriosam. Velit, architecto atque repellat sapiente hic eius eos consequuntur perspiciatis quos. Veritatis eveniet esse minima repellendus!</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "info": "Limit the number of products displayed.",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products Per Row",
      "info": "Number of products per row.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
