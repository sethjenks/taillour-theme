{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- assign padding_default = section.settings.padding_top_bottom | default: 6 -%}
{%- assign padding_top = padding_default -%}
{%- assign padding_bottom = padding_default -%}
{%- if section.settings.enable_padding_overrides -%}
  {%- assign padding_top = section.settings.padding_top -%}
  {%- assign padding_bottom = section.settings.padding_bottom -%}
{%- endif -%}
{%- assign position_mode = section.settings.position_mode | default: 'preset' -%}
{%- assign object_position_desktop = section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_desktop = section.settings.object_position_x | append: '% ' | append: section.settings.object_position_y | append: '%' -%}
{%- endif -%}
{%- assign object_position_mobile = section.settings.object_position_mobile | default: section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_mobile = section.settings.object_position_x_mobile | append: '% ' | append: section.settings.object_position_y_mobile | append: '%' -%}
{%- endif -%}
{% style %}
#{{ section.id }}.promotion-hero {
  min-height: {{ section.settings.desktop_height | append: "vw" }};
  --promotion-media-max-height: {{ section.settings.media_max_height | append: "vh" }};
  --promotion-media-top: {{ section.settings.media_top_inset | append: "px" }};
  --promotion-media-offset-x: {{ section.settings.media_offset_x | append: "%" }};
  --promotion-media-offset-y: {{ section.settings.media_offset_y | append: "%" }};
  --promotion-blob-1-size: {{ section.settings.blob1_size | append: "vw" }};
  --promotion-blob-1-x: {{ section.settings.blob1_x | append: "%" }};
  --promotion-blob-1-y: {{ section.settings.blob1_y | append: "%" }};
  --promotion-blob-1-color: {{ section.settings.blob1_color }};
  --promotion-blob-1-blur: {{ section.settings.blob1_blur | append: "px" }};
  --promotion-blob-1-opacity: {{ section.settings.blob1_opacity | divided_by: 100.0 }};
  --promotion-blob-2-size: {{ section.settings.blob2_size | append: "vw" }};
  --promotion-blob-2-x: {{ section.settings.blob2_x | append: "%" }};
  --promotion-blob-2-y: {{ section.settings.blob2_y | append: "%" }};
  --promotion-blob-2-color: {{ section.settings.blob2_color }};
  --promotion-blob-2-blur: {{ section.settings.blob2_blur | append: "px" }};
  --promotion-blob-2-opacity: {{ section.settings.blob2_opacity | divided_by: 100.0 }};
}
#{{ section.id }} .promotion-hero-media img {
  object-fit: {{ section.settings.object_fit }};
  object-position: {{ object_position_desktop }};
}
@media screen and (max-width: 768px) {
  #{{ section.id }}.promotion-hero {
    min-height: {{ section.settings.mobile_height | append: "vw" }};
    --promotion-media-offset-x: {{ section.settings.media_offset_x_mobile | append: "%" }};
    --promotion-media-offset-y: {{ section.settings.media_offset_y_mobile | append: "%" }};
  }
  #{{ section.id }} .promotion-hero-media img {
    object-position: {{ object_position_mobile }};
  }
}
{% endstyle %}

{%- assign heading_text = '' -%}
{%- assign heading_size = 'h1' -%}
{%- assign body_text = '' -%}
{%- assign button1_label = '' -%}
{%- assign button1_link = '' -%}
{%- assign button1_enable = false -%}
{%- assign button2_label = '' -%}
{%- assign button2_link = '' -%}
{%- assign button2_enable = false -%}

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'heading' -%}
      {%- assign heading_text = block.settings.text -%}
      {%- assign heading_size = block.settings.size -%}
    {%- when 'text' -%}
      {%- assign body_text = block.settings.text -%}
    {%- when 'buttons' -%}
      {%- assign button1_label = block.settings.button1_label -%}
      {%- assign button1_link = block.settings.button1_link -%}
      {%- assign button1_enable = block.settings.button1_enable -%}
      {%- assign button2_label = block.settings.button2_label -%}
      {%- assign button2_link = block.settings.button2_link -%}
      {%- assign button2_enable = block.settings.button2_enable -%}
  {%- endcase -%}
{%- endfor -%}

{%- assign hero_image = section.settings.hero_image -%}
{%- assign hero_image_mobile = section.settings.hero_image_mobile -%}
{%- assign primary_heading = section.settings.primary_text | default: heading_text -%}
{%- assign secondary_heading = section.settings.secondary_text -%}

<div
  id="{{ section.id }}"
  class="promotion-hero section-pad {{ scheme_class }}"
  style="background-color: var(--theme-bg-primary, #ffffff); color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color)); --section-padding-default: {{ padding_default | append: 'rem' }};{% if section.settings.enable_padding_overrides %} --section-padding-top: {{ padding_top | append: 'rem' }}; --section-padding-bottom: {{ padding_bottom | append: 'rem' }};{% endif %}{% if section.settings.background_image != blank %} background-image: url({{ section.settings.background_image | image_url: width: 2000 }}); background-size: cover; background-position: center; background-repeat: no-repeat;{% endif %}"
>
  {%- if section.settings.blob1_enable or section.settings.blob2_enable -%}
    <div class="promotion-hero__blobs" aria-hidden="true">
      {%- if section.settings.blob1_enable -%}
        <span class="promotion-hero__blob promotion-hero__blob--one"></span>
      {%- endif -%}
      {%- if section.settings.blob2_enable -%}
        <span class="promotion-hero__blob promotion-hero__blob--two"></span>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="section promotion-hero-inner">
    <div class="promotion-hero-content">
      {%- if primary_heading != blank -%}
        <{{ heading_size }} class="promotion-hero-title">
          <span class="promotion-hero-title-primary">{{ primary_heading }}</span>
          {%- if secondary_heading != blank -%}
            <span class="promotion-hero-title-secondary">{{ secondary_heading }}</span>
          {%- endif -%}
        </{{ heading_size }}>
      {%- endif -%}
      {%- if body_text != blank -%}
        <p class="promotion-hero-body">{{ body_text }}</p>
      {%- endif -%}
      <div class="promotion-hero-buttons">
        {%- if button1_enable and button1_label != blank -%}
          <a class="button button-primary" href="{{ button1_link | default: '#' }}">
            {{ button1_label }}
          </a>
        {%- endif -%}
        {%- if button2_enable and button2_label != blank -%}
          <a class="button button-secondary" href="{{ button2_link | default: '#' }}">
            {{ button2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="promotion-hero-media" aria-hidden="true">
    {%- if hero_image == blank -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- else -%}
      {%- if section.settings.use_focal_point -%}
        <picture>
          {%- if hero_image_mobile != blank -%}
            <source
              media="(max-width: 768px)"
              srcset="{{ hero_image_mobile | image_url: width: 900 }}"
            >
          {%- endif -%}
          {{ hero_image | image_url: width: 1400 | image_tag: alt: hero_image.alt, loading: 'lazy' }}
        </picture>
      {%- else -%}
        <picture>
          {%- if hero_image_mobile != blank -%}
            <source
              media="(max-width: 768px)"
              srcset="{{ hero_image_mobile | image_url: width: 900 }}"
            >
          {%- endif -%}
          <img
            src="{{ hero_image | image_url: width: 1400 }}"
            width="{{ hero_image.width }}"
            height="{{ hero_image.height }}"
            alt="{{ hero_image.alt }}"
            loading="lazy"
          >
        </picture>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
