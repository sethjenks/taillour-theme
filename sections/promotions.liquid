{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- assign position_mode = section.settings.position_mode | default: 'preset' -%}
{%- assign object_position_desktop = section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_desktop = section.settings.object_position_x | append: '% ' | append: section.settings.object_position_y | append: '%' -%}
{%- endif -%}
{%- assign object_position_mobile = section.settings.object_position_mobile | default: section.settings.object_position -%}
{%- if position_mode == 'custom' -%}
  {%- assign object_position_mobile = section.settings.object_position_x_mobile | append: '% ' | append: section.settings.object_position_y_mobile | append: '%' -%}
{%- endif -%}
{% style %}
#{{ section.id }} .promotion-hero {
  min-height: {{ section.settings.desktop_height | append: "vw" }};
}
#{{ section.id }} .promotion-hero-media img {
  object-fit: {{ section.settings.object_fit }};
  object-position: {{ object_position_desktop }};
}
@media screen and (max-width: 768px) {
  #{{ section.id }} .promotion-hero {
    min-height: {{ section.settings.mobile_height | append: "vw" }};
  }
  #{{ section.id }} .promotion-hero-media img {
    object-position: {{ object_position_mobile }};
  }
}
{% endstyle %}

{%- assign heading_text = '' -%}
{%- assign heading_size = 'h1' -%}
{%- assign body_text = '' -%}
{%- assign button1_label = '' -%}
{%- assign button1_link = '' -%}
{%- assign button1_enable = false -%}
{%- assign button2_label = '' -%}
{%- assign button2_link = '' -%}
{%- assign button2_enable = false -%}

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'heading' -%}
      {%- assign heading_text = block.settings.text -%}
      {%- assign heading_size = block.settings.size -%}
    {%- when 'text' -%}
      {%- assign body_text = block.settings.text -%}
    {%- when 'buttons' -%}
      {%- assign button1_label = block.settings.button1_label -%}
      {%- assign button1_link = block.settings.button1_link -%}
      {%- assign button1_enable = block.settings.button1_enable -%}
      {%- assign button2_label = block.settings.button2_label -%}
      {%- assign button2_link = block.settings.button2_link -%}
      {%- assign button2_enable = block.settings.button2_enable -%}
  {%- endcase -%}
{%- endfor -%}

{%- assign hero_image = section.settings.hero_image | default: section.settings.image -%}
{%- assign primary_heading = section.settings.primary_text | default: heading_text -%}
{%- assign secondary_heading = section.settings.secondary_text -%}

<div
  id="{{ section.id }}"
  class="promotion-hero {{ scheme_class }}"
  style="background-color: var(--theme-bg-primary, #ffffff); color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));{% if section.settings.background_image != blank %} background-image: url({{ section.settings.background_image | image_url: width: 2000 }}); background-size: cover; background-position: center; background-repeat: no-repeat;{% endif %}"
>
  <div class="section promotion-hero-inner">
    <div class="promotion-hero-content">
      {%- if primary_heading != blank -%}
        <{{ heading_size }} class="promotion-hero-title">
          <span class="promotion-hero-title-primary">{{ primary_heading }}</span>
          {%- if secondary_heading != blank -%}
            <span class="promotion-hero-title-secondary">{{ secondary_heading }}</span>
          {%- endif -%}
        </{{ heading_size }}>
      {%- endif -%}
      {%- if body_text != blank -%}
        <p class="promotion-hero-body">{{ body_text }}</p>
      {%- endif -%}
      <div class="promotion-hero-buttons">
        {%- if button1_enable and button1_label != blank -%}
          <a class="button button-primary" href="{{ button1_link | default: '#' }}">
            {{ button1_label }}
          </a>
        {%- endif -%}
        {%- if button2_enable and button2_label != blank -%}
          <a class="button button-secondary" href="{{ button2_link | default: '#' }}">
            {{ button2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="promotion-hero-media" aria-hidden="true">
    {%- if hero_image == blank -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- else -%}
      {%- if section.settings.use_focal_point -%}
        {{ hero_image | image_url: width: 1400 | image_tag: alt: hero_image.alt, loading: 'lazy' }}
      {%- else -%}
        <img
          src="{{ hero_image | image_url: width: 1400 }}"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
          alt="{{ hero_image.alt }}"
          loading="lazy"
        >
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Promotions",
  "tag": "section",
  "class": "promotions-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "checkbox",
      "id": "use_focal_point",
      "label": "Use image focal point",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Hero Text"
    },
    {
      "type": "inline_richtext",
      "id": "primary_text",
      "label": "Primary Text",
      "default": "Make picks."
    },
    {
      "type": "inline_richtext",
      "id": "secondary_text",
      "label": "Secondary Text",
      "default": "Get the dub."
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "object_position",
      "label": "Position",
      "options": [
        {
          "value": "left top",
          "label": "Top left"
        },
        {
          "value": "center top",
          "label": "Top center"
        },
        {
          "value": "right top",
          "label": "Top right"
        },
        {
          "value": "left center",
          "label": "Center left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Center right"
        },
        {
          "value": "left bottom",
          "label": "Bottom left"
        },
        {
          "value": "center bottom",
          "label": "Bottom center"
        },
        {
          "value": "right bottom",
          "label": "Bottom right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "position_mode",
      "label": "Position mode",
      "options": [
        {
          "value": "preset",
          "label": "Preset positions"
        },
        {
          "value": "custom",
          "label": "Custom X/Y"
        }
      ],
      "default": "preset"
    },
    {
      "type": "range",
      "id": "object_position_x",
      "label": "Position X (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.position_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "object_position_y",
      "label": "Position Y (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.position_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "object_position_mobile",
      "label": "Position (mobile)",
      "options": [
        {
          "value": "left top",
          "label": "Top left"
        },
        {
          "value": "center top",
          "label": "Top center"
        },
        {
          "value": "right top",
          "label": "Top right"
        },
        {
          "value": "left center",
          "label": "Center left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Center right"
        },
        {
          "value": "left bottom",
          "label": "Bottom left"
        },
        {
          "value": "center bottom",
          "label": "Bottom center"
        },
        {
          "value": "right bottom",
          "label": "Bottom right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "object_position_x_mobile",
      "label": "Position X (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.position_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "object_position_y_mobile",
      "label": "Position Y (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.position_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Height (desktop)",
      "min": 25,
      "max": 100,
      "step": 1,
      "default": 33,
      "unit": "vw",
      "info": "Height of the section in relation to the browser width."
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Height (mobile)",
      "min": 50,
      "max": 100,
      "step": 1,
      "default": 100,
      "unit": "vw",
      "info": "Height of the section in relation to the device width."
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Headline",
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Asperiores voluptatem rerum fuga assumenda similique voluptatem sapiente qui non voluptatibus.",
          "label": "Text"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button1_label",
          "default": "Button label",
          "label": "Button 1 Label "
        },
        {
          "type": "url",
          "id": "button1_link",
          "label": "Button 1 Link"
        },
        {
          "type": "checkbox",
          "id": "button1_enable",
          "default": true,
          "label": "Show Button 1?"
        },
        {
          "type": "text",
          "id": "button2_label",
          "default": "Button label",
          "label": "Button 2 Label"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Button 2 Link"
        },
        {
          "type": "checkbox",
          "id": "button2_enable",
          "default": false,
          "label": "Show Button 2?"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promotions",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
