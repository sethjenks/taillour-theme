      "unit": "%"
    },
    {
      "type": "range",
      "id": "media_offset_y",
      "label": "Hero image offset Y (desktop)",
      "min": -30,
      "max": 30,
      "step": 1,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "media_offset_x_mobile",
