    },
    {
      "type": "number",
      "id": "media_width_min",
      "label": "Hero image width min (desktop, px)",
      "default": 320
    },
    {
      "type": "number",
      "id": "media_width_preferred",
      "label": "Hero image width preferred (desktop, vw)",
