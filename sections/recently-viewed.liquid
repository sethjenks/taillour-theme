{% liquid
# This section must be added to the PDP for the recently viewed feature
# to work correctly.
assign image_width = 400
assign active_scheme = settings.default_color_scheme
if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank
  assign active_scheme = section.settings.color_scheme
endif
assign scheme_class = ''
if active_scheme != blank
  assign scheme_class = 'color-' | append: active_scheme.id
endif
%}
{% style %}
#recently-viewed.section-wrap:before {
  background-color: var(--theme-bg-primary, #ffffff);
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
}
#recently-viewed .products-grid {
  --product-card-min: 274px;
  grid-template-columns: repeat(auto-fit, minmax(var(--product-card-min), 1fr));
}
  #recently-viewed.recently-viewed--hidden {
    display: none;
  }
{% endstyle %}

<section id="recently-viewed" class="section-wrap recently-viewed--hidden {{ scheme_class }}" style="color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));">
  {%- if section.settings.anchor_id != blank -%}<div id="{{ section.settings.anchor_id }}"></div>{%- endif -%}
  <div class="section">
    <{{- section.settings.size }}>
      {{- section.settings.heading -}}
    </{{ section.settings.size -}}>
    <div id="js--recently_viewed" class="products-grid"></div>
  </div>
</section>

<script>
/*
* GET RECENTLY VIEWED ITEMS
* Returns list of recently viewed items from local storage.
*/
function _getRecentlyViewed() {
  let recentlyViewed = localStorage.getItem("recentlyViewed");
  let items = JSON.parse(recentlyViewed);
  // console.log(items);
  if (items !== null && items[0] !== undefined) {
    let sortedItems = items.sort(function(a, b) {
      return a.timestamp - b.timestamp;
    });
    return sortedItems;
  } else {
    return [];
  }
};

/*
* SAVE RECENTLY VIEWED ITEM
* Saves item to local storage data.
* @param $handle (string) - Product handle
*/
function saveRecentlyViewedProduct(handle) {
  let recentlyViewed = _getRecentlyViewed();
  let exists = false;
  let maxItemsToSave = 8;
  recentlyViewed.forEach(function(item, index) {
    if (item.handle == handle) {
      exists = true;
    }
  });

  if (exists === false) {
    // Trim the array
    recentlyViewed.splice(maxItemsToSave);
    // Append the new data to the recentlyViewed array
    recentlyViewed.unshift({
      handle: handle,
      date: Date.now(),
    });
    // Re-save the updated data back to local storage
    localStorage.setItem("recentlyViewed", JSON.stringify(recentlyViewed));
  }

  // Reload the recentlyViewed list
  _getRecentlyViewed();
};

/*
* DISPLAYS RECENTLY VIEWED ITEMS
* Displays the items on the page. This looks for .js--recently_viewed.
*/
function displayRecentlyViewed() {
  let items = _getRecentlyViewed();
  const limit = {{ section.settings.limit }};
  const el = document.getElementById("js--recently_viewed");
  const section = document.getElementById("recently-viewed");
  if (section != null) {
    if (items.length > 0) {
      const total = Math.min(items.length, limit);
      let loadedCount = 0;
      let insertedCount = 0;
      items.forEach(function(item, index) {
        if ((index + 1) <= limit) {
          let url = `/products/${item.handle}?view=card`;
          fetch(url, {
              method: "GET",
              redirect: "error",
            })
            .then(function(response) {
              if (response.status == 200) {
                return response.text();
              } else {
                // Remove this item from the array.
                let cleanUpArray = items.filter((i) => i.handle != item.handle);
                localStorage.setItem("recentlyViewed", JSON.stringify(cleanUpArray));
                return "";
              }
            })
            .then(function(card) {
              if (card) {
                el.insertAdjacentHTML("beforeend", card);
                insertedCount += 1;
                section.classList.remove("recently-viewed--hidden");
              }
            })
            .catch(function(error) {
              // Remove this item from the array.
              let cleanUpArray = items.filter((i) => i.handle != item.handle);
              localStorage.setItem("recentlyViewed", JSON.stringify(cleanUpArray));
            })
            .finally(function() {
              loadedCount += 1;
              if (loadedCount === total && insertedCount === 0) {
                section.classList.add("recently-viewed--hidden");
              }
            });
        }
      });
    } else {
      section.classList.add("recently-viewed--hidden");
    }
  }
};
ready(function() {
  displayRecentlyViewed();
  {% if template.name == "product" -%}
  saveRecentlyViewedProduct('{{ product.handle }}');
  {%- endif -%}
});
</script>

{% schema %}
{
  "name": "Recently Viewed",
  "tag": "section",
  "class": "recently-viewed-section",
  "limit": 1,
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Recently Viewed"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Text",
      "default": "Recently viewed",
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "info": "Number of products displayed.",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products Per Row",
      "info": "Number of products per row.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Enter a unique ID (e.g. 'about') so buttons can scroll to this section using '#about'."
    }
  ]
}
{% endschema %}
