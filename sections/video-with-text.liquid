{%- assign active_scheme = settings.default_color_scheme -%}
{%- if section.settings.use_default_color_scheme == false and section.settings.color_scheme != blank -%}
  {%- assign active_scheme = section.settings.color_scheme -%}
{%- endif -%}
{%- assign scheme_class = '' -%}
{%- if active_scheme != blank -%}
  {%- assign scheme_class = 'color-' | append: active_scheme.id -%}
{%- endif -%}
{%- style -%}
.video-text-left .video-text-asset {
  order: -1;
}
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color: var(--theme-bg-primary, #ffffff);
  {%- if section.settings.background_image != blank -%}
  background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {%- endif -%}
}
{{ section.id | prepend: '#' }}.section-wrap {
  --video-text-grid-align: {{ section.settings.vertical_alignment | default: 'center' }};
}
@media screen and (min-width: 769px) {
  {{ section.id | prepend: '#' }} .grid-2 {
    align-items: var(--video-text-grid-align);
  }
}
{{ section.id | prepend: '#' }} .video-text-content h1,
{{ section.id | prepend: '#' }} .video-text-content h2,
{{ section.id | prepend: '#' }} .video-text-content h3,
{{ section.id | prepend: '#' }} .video-text-content h4,
{{ section.id | prepend: '#' }} .video-text-content h5 {
  color: var(--theme-text-primary, var(--font-primary-color));
}
{{ section.id | prepend: '#' }} .video-text-content .rte,
{{ section.id | prepend: '#' }} .video-text-content .rte p {
  color: var(--theme-text-secondary, var(--font-secondary-color));
}
{%- endstyle -%}

<div id="{{ section.id }}" class="section-wrap {{ scheme_class }}" style="color: var(--theme-text-primary, inherit); --font-primary-color: var(--theme-text-primary, var(--font-primary-color)); --font-secondary-color: var(--theme-text-secondary, var(--font-secondary-color));">
  <div class="section">
    {%- if section.settings.show_heading == true -%}
      <{{ section.settings.size }}>
        {{ section.settings.text }}
      </{{ section.settings.size }}>
    {%- endif -%}

    {%- if section.settings.show_description == true -%}
      <div class="rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    <div class="grid-2 video-text-{{ section.settings.video_position }}">
      <!-- content -->
      <div class="video-text-content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <{{- block.settings.size }}>{{ block.settings.text }}</{{- block.settings.size -}}>
            {%- when 'text' -%}
              <div class="rte">
                {{ block.settings.text }}
              </div>
            {% when 'buttons' %}
              <p>
                <a class="button button-primary" href="{{ block.settings.button_link | default: '#' }}">
                  {{ block.settings.button_label }}
                </a>
              </p>
            {% when 'bullet_item' %}
              {%- capture icon_style -%}
                --bullet-icon-bg: {{ block.settings.icon_background | default: '#a87be6' }};
                --bullet-icon-border: {{ block.settings.icon_border_color | default: '#19212b' }};
                --bullet-icon-text: {{ block.settings.icon_text_color | default: '#ffffff' }};
                {%- if block.settings.icon_bg_image != blank -%}
                  background-image: url('{{ block.settings.icon_bg_image | image_url: width: 128 }}');
                {%- endif -%}
              {%- endcapture -%}

              <div class="bullet-item" {{ block.shopify_attributes }}>
                <div class="bullet-item__icon{% if block.settings.icon_shadow %} bullet-item__icon--shadow{% endif %}" style="{{ icon_style | strip }}">
                  {% unless block.settings.icon_text == blank %}
                    <span class="bullet-item__icon-text">{{ block.settings.icon_text }}</span>
                  {% endunless %}
                </div>
                <div class="bullet-item__content">
                  {% unless block.settings.title == blank %}
                    <div class="bullet-item__title">{{ block.settings.title }}</div>
                  {% endunless %}
                  {% unless block.settings.subtext == blank %}
                    <div class="bullet-item__subtext rte">{{ block.settings.subtext }}</div>
                  {% endunless %}
                </div>
              </div>
          {% endcase %}
        {%- endfor -%}
      </div>
      <div class="video-text-asset">
        <!-- video -->
        <div>
          {% if section.settings.video == blank %}
            {{ 'collection-4' | placeholder_svg_tag: "placeholder" }}
          {% else %}
            {% capture video_sizes %}
            width:100%; height:100%; object-fit: {{ section.settings.object_fit }}; object-position: {{ section.settings.object_position }}; aspect-ratio: {{ section.settings.aspect_ratio }}
            {% endcapture %}

            {% liquid
            if section.settings.video.type == 'youtube'
              assign video_src = section.settings.video.id | prepend: "https://www.youtube.com/embed/"
              assign video_class = "video-iframe-youtube"
            else
              assign video_src = section.settings.video.id | prepend: "https://player.vimeo.com/video/"
              assign video_class = "video-iframe-vimeo"
            endif
            %}
            <iframe
              class="{{ video_class }}"
              style="{{ video_sizes }}"
              src="{{ video_src }}"
              width="{{ section.settings.video_width }}"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen></iframe>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video & Text",
  "tag": "section",
  "class": "video-text-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "inline_richtext",
      "id": "text",
      "label": "Heading",
      "default": "Headline",
    },
    {
      "visible_if": "{{ section.settings.show_heading == true }}",
      "type": "select",
      "id": "size",
      "label": "Heading Size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.show_description == true }}",
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Alias blanditiis libero ut laboriosam. Velit, architecto atque repellat sapiente hic eius eos consequuntur perspiciatis quos. Veritatis eveniet esse minima repellendus!</p>"
    },
    {
      "type": "checkbox",
      "id": "use_default_color_scheme",
      "label": "Use default color scheme",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.use_default_color_scheme == false }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment (desktop)",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "Video URL",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "object_position",
      "label": "Position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "options": [
        {
          "value": "1/1",
          "label": "1:1 (Square)"
        },
        {
          "value": "3/2",
          "label": "3:2 (Portrait)"
        },
        {
          "value": "5/4",
          "label": "5:4 (Portrait)"
        },
        {
          "value": "4/3",
          "label": "4:3 (Landscape)"
        },
        {
          "value": "16/9",
          "label": "16:9 (Landscape)"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "range",
      "id": "video_width",
      "min": 400,
      "max": 1020,
      "step": 10,
      "unit": "px",
      "label": "Video Width",
      "default": 600
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Video Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Headline",
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Asperiores voluptatem rerum fuga assumenda similique voluptatem sapiente qui non voluptatibus.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Button Label "
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    },
    {
      "type": "bullet_item",
      "name": "Bullet item",
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon text",
          "default": "01"
        },
        {
          "type": "image_picker",
          "id": "icon_bg_image",
          "label": "Icon background image"
        },
        {
          "type": "color",
          "id": "icon_background",
          "label": "Icon background color",
          "default": "#a87be6"
        },
        {
          "type": "color",
          "id": "icon_border_color",
          "label": "Icon border color",
          "default": "#19212b"
        },
        {
          "type": "color",
          "id": "icon_text_color",
          "label": "Icon text color",
          "default": "#ffffff"
        },
        {
          "type": "checkbox",
          "id": "icon_shadow",
          "label": "Show icon shadow",
          "default": true
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Make your picks"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext",
          "default": "<p>Choose a tournament. Make your picks before play begins.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video & Text",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
